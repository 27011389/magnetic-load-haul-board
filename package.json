{
  "name": "magnetic-load-haul-board",
  "version": "1.0.4",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && npm run validate:artifact",
    "start": "next start --hostname 0.0.0.0",
    "backup": "node scripts/backup-database.mjs",
    "package:onsite": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/Create-OnsitePackage.ps1",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Magnetic Load and Haul Shiftboard"
}
